# Copiar a .env y generar una clave aleatoria de al menos 32 caracteres.
PROCESSOR_API_TOKEN=
PROCESSOR_MAX_BYTES=20971520
PROCESSOR_MAX_PAGES=100
PROCESSOR_TIMEOUT_SECONDS=120
PROCESSOR_MAX_TEXT_CHARS=1000000
PROCESSOR_MIN_CHARS=80
PROCESSOR_MIN_WORDS=12
PROCESSOR_MIN_PRINTABLE_RATIO=0.95
PROCESSOR_MIN_ALNUM_RATIO=0.55
PROCESSOR_MAX_IMAGE_COVERAGE=0.65

# OCR: ruta del ejecutable del servidor; nunca enviada por el navegador.
PROCESSOR_OCR_ENABLED=true
PROCESSOR_TESSERACT_CMD=tesseract
PROCESSOR_TESSDATA_DIR=
PROCESSOR_REFINEMENT_TESSDATA_DIR=
PROCESSOR_REFINEMENT_TESSDATA_DIR=
PROCESSOR_OCR_MODE=automatico
PROCESSOR_OCR_TIMEOUT_SECONDS=40
PROCESSOR_RENDER_DPI=250
PROCESSOR_MAX_IMAGE_PIXELS=12000000
PROCESSOR_CORRECT_ORIENTATION=true
PROCESSOR_OSD_MIN_CONFIDENCE=5
PROCESSOR_PREPROCESS_GRAYSCALE=true
PROCESSOR_PREPROCESS_CONTRAST=true
PROCESSOR_PREPROCESS_DESKEW=true
PROCESSOR_PREPROCESS_DENOISE=false
PROCESSOR_PREPROCESS_BINARIZE=false
PROCESSOR_PREPROCESS_UPSCALE=true

PROCESSOR_MAX_PDF_BYTES=41943040
